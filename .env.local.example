# Copier vers .env.local pour `npm run dev` (Next.js le charge automatiquement).
# URL du backend FastAPI (ansdback-main), vue depuis le NAVIGATEUR.
#
# NEXT_PUBLIC_* est injecte dans le bundle au moment du `next build` :
# en Docker il est passe comme build arg (voir docker-compose.yml), et le
# changer impose de reconstruire l'image. Cote backend, l'URL du frontend
# doit figurer dans CORS_ORIGINS (voir ansdback-main/.env.example).
NEXT_PUBLIC_API_URL=http://localhost:8000
